{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/shellghostt/schemasentry/schema/snapshot-v1.schema.json",
  "title": "SchemaSentry snapshot v1",
  "description": "The read-only, deterministic schema state produced by `schemasentry snapshot`. Every field is present; null means unknown, not zero.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "dialect",
    "serverVersion",
    "capturedAt",
    "database",
    "schemas",
    "tables",
    "sequences",
    "extensions"
  ],
  "properties": {
    "schemaVersion": {
      "const": 1
    },
    "dialect": {
      "type": "string",
      "enum": [
        "postgres"
      ]
    },
    "serverVersion": {
      "type": "string",
      "minLength": 1
    },
    "capturedAt": {
      "type": "string",
      "format": "date-time"
    },
    "database": {
      "type": "string",
      "minLength": 1
    },
    "schemas": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "tables": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/table"
      }
    },
    "sequences": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/sequence"
      }
    },
    "extensions": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "catalogEvidence": {
      "anyOf": [
        {
          "additionalProperties": false,
          "properties": {
            "evidenceVersion": {
              "const": 1,
              "title": "Evidenceversion",
              "type": "integer"
            },
            "scopeSchemas": {
              "items": {
                "type": "string"
              },
              "title": "Scopeschemas",
              "type": "array"
            },
            "relations": {
              "items": {
                "$ref": "#/$defs/RelationFact"
              },
              "title": "Relations",
              "type": "array"
            },
            "constraintValidity": {
              "items": {
                "$ref": "#/$defs/ConstraintValidity"
              },
              "title": "Constraintvalidity",
              "type": "array"
            },
            "enums": {
              "items": {
                "$ref": "#/$defs/EnumDefinition"
              },
              "title": "Enums",
              "type": "array"
            },
            "enumColumns": {
              "items": {
                "$ref": "#/$defs/EnumColumn"
              },
              "title": "Enumcolumns",
              "type": "array"
            },
            "incomingForeignKeys": {
              "items": {
                "$ref": "#/$defs/IncomingForeignKey"
              },
              "title": "Incomingforeignkeys",
              "type": "array"
            },
            "unsupportedTypes": {
              "default": [],
              "items": {
                "$ref": "#/$defs/UnsupportedType"
              },
              "title": "Unsupportedtypes",
              "type": "array"
            }
          },
          "required": [
            "evidenceVersion",
            "scopeSchemas",
            "relations",
            "constraintValidity",
            "enums",
            "enumColumns",
            "incomingForeignKeys"
          ],
          "title": "CatalogEvidence",
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "description": "Optional version-1 M4 catalog evidence. Omission/null means unknown."
    }
  },
  "$defs": {
    "table": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "name",
        "rowEstimate",
        "totalBytes",
        "columns",
        "constraints",
        "indexes"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "rowEstimate": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 0,
          "description": "pg_class.reltuples, or null when the table has never been analysed."
        },
        "totalBytes": {
          "type": "integer",
          "minimum": 0
        },
        "columns": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/column"
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/constraint"
          }
        },
        "indexes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/index"
          }
        }
      }
    },
    "column": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "ordinal",
        "type",
        "normalisedType",
        "length",
        "nullable",
        "default",
        "identity",
        "generated",
        "generationExpression"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "ordinal": {
          "type": "integer",
          "minimum": 1
        },
        "type": {
          "type": "string",
          "minLength": 1,
          "description": "format_type output, verbatim, including an unknown user-defined type."
        },
        "normalisedType": {
          "type": "string",
          "minLength": 1,
          "description": "Dialect-independent short name. Unknown type names are repeated verbatim."
        },
        "length": {
          "type": [
            "integer",
            "null"
          ],
          "minimum": 1,
          "description": "Declared length for varchar, char and bit types; null otherwise."
        },
        "nullable": {
          "type": "boolean"
        },
        "default": {
          "type": [
            "string",
            "null"
          ],
          "description": "Default expression. Null for generated columns, whose expression is in generationExpression."
        },
        "identity": {
          "type": "boolean"
        },
        "generated": {
          "type": [
            "string",
            "null"
          ],
          "description": "attgenerated, e.g. stored; null for an ordinary column."
        },
        "generationExpression": {
          "type": [
            "string",
            "null"
          ],
          "description": "The generation expression, preserved so a change to it is visible to the diff."
        }
      }
    },
    "constraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "kind",
        "columns",
        "referencedTable",
        "referencedColumns"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "kind": {
          "type": "string",
          "enum": [
            "primary_key",
            "unique",
            "foreign_key",
            "check",
            "exclusion",
            "trigger"
          ]
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Empty for a check constraint that names no column."
        },
        "referencedTable": {
          "type": [
            "string",
            "null"
          ],
          "description": "schema.table for a foreign key; null otherwise."
        },
        "referencedColumns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Referenced columns for a foreign key; empty otherwise."
        },
        "definition": {
          "type": [
            "string",
            "null"
          ]
        }
      }
    },
    "index": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name",
        "columns",
        "unique",
        "method",
        "predicate",
        "valid",
        "expression"
      ],
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1
        },
        "columns": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "description": "Plain key columns only. Expressions are in expression."
        },
        "unique": {
          "type": "boolean"
        },
        "method": {
          "type": "string",
          "minLength": 1
        },
        "predicate": {
          "type": [
            "string",
            "null"
          ],
          "description": "Partial index predicate, or null."
        },
        "valid": {
          "type": "boolean"
        },
        "expression": {
          "type": [
            "string",
            "null"
          ],
          "description": "Server rendering of index expressions, or null."
        },
        "keys": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        },
        "includedColumns": {
          "type": [
            "array",
            "null"
          ],
          "items": {
            "type": "string"
          }
        }
      }
    },
    "sequence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "schema",
        "name",
        "dataType",
        "startValue",
        "incrementBy",
        "cycle"
      ],
      "properties": {
        "schema": {
          "type": "string",
          "minLength": 1
        },
        "name": {
          "type": "string",
          "minLength": 1
        },
        "dataType": {
          "type": "string",
          "minLength": 1
        },
        "startValue": {
          "type": "integer"
        },
        "incrementBy": {
          "type": "integer"
        },
        "cycle": {
          "type": "boolean"
        }
      }
    },
    "ConstraintValidity": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "minLength": 1,
          "title": "Schema",
          "type": "string"
        },
        "table": {
          "minLength": 1,
          "title": "Table",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "kind": {
          "enum": [
            "check",
            "foreign_key"
          ],
          "title": "Kind",
          "type": "string"
        },
        "validated": {
          "title": "Validated",
          "type": "boolean"
        }
      },
      "required": [
        "schema",
        "table",
        "name",
        "kind",
        "validated"
      ],
      "title": "ConstraintValidity",
      "type": "object"
    },
    "EnumColumn": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "minLength": 1,
          "title": "Schema",
          "type": "string"
        },
        "table": {
          "minLength": 1,
          "title": "Table",
          "type": "string"
        },
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "typeSchema": {
          "minLength": 1,
          "title": "Typeschema",
          "type": "string"
        },
        "typeName": {
          "minLength": 1,
          "title": "Typename",
          "type": "string"
        },
        "mode": {
          "enum": [
            "direct",
            "array",
            "domain"
          ],
          "title": "Mode",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "table",
        "column",
        "typeSchema",
        "typeName",
        "mode"
      ],
      "title": "EnumColumn",
      "type": "object"
    },
    "EnumDefinition": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "minLength": 1,
          "title": "Schema",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "labels": {
          "items": {
            "type": "string"
          },
          "title": "Labels",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "name",
        "labels"
      ],
      "title": "EnumDefinition",
      "type": "object"
    },
    "IncomingForeignKey": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "minLength": 1,
          "title": "Schema",
          "type": "string"
        },
        "table": {
          "minLength": 1,
          "title": "Table",
          "type": "string"
        },
        "name": {
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "targetSchema": {
          "minLength": 1,
          "title": "Targetschema",
          "type": "string"
        },
        "targetTable": {
          "minLength": 1,
          "title": "Targettable",
          "type": "string"
        },
        "targetColumns": {
          "items": {
            "type": "string"
          },
          "minItems": 1,
          "title": "Targetcolumns",
          "type": "array"
        }
      },
      "required": [
        "schema",
        "table",
        "name",
        "targetSchema",
        "targetTable",
        "targetColumns"
      ],
      "title": "IncomingForeignKey",
      "type": "object"
    },
    "RelationFact": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "minLength": 1,
          "title": "Schema",
          "type": "string"
        },
        "table": {
          "minLength": 1,
          "title": "Table",
          "type": "string"
        },
        "kind": {
          "enum": [
            "ordinary",
            "partitioned"
          ],
          "title": "Kind",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "table",
        "kind"
      ],
      "title": "RelationFact",
      "type": "object"
    },
    "UnsupportedType": {
      "additionalProperties": false,
      "properties": {
        "schema": {
          "minLength": 1,
          "title": "Schema",
          "type": "string"
        },
        "table": {
          "minLength": 1,
          "title": "Table",
          "type": "string"
        },
        "column": {
          "minLength": 1,
          "title": "Column",
          "type": "string"
        },
        "reason": {
          "enum": [
            "domain_dependency",
            "composite_dependency"
          ],
          "title": "Reason",
          "type": "string"
        }
      },
      "required": [
        "schema",
        "table",
        "column",
        "reason"
      ],
      "title": "UnsupportedType",
      "type": "object"
    }
  }
}
